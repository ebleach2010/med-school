{
  "name": "neuro-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive clinical neurology learning platform (educational use only)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "smoke": "node scripts/smoke.mjs",
    "coverage": "tsx scripts/coverage-report.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
